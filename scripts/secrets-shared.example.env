# Copy to ~/.maraehub/shared-secrets.env (outside the repo), chmod 600, and fill in.
# These are MaraeHub's own accounts, the same for every marae. Never commit the real file.
FROM_EMAIL=
ADMIN_ALERT_EMAIL=
RESEND_API_KEY=
ANTHROPIC_API_KEY=
# only if a marae uses these:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
CLICKUP_API_TOKEN=
